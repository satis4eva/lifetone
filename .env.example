# Copy to .env and fill in. Never commit .env.

# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/lifetone"

# Long random string used to sign login cookies (e.g. `openssl rand -hex 32`)
SESSION_SECRET=""

# Brand used when the request's domain doesn't match any brand (e.g. localhost)
DEFAULT_BRAND="lifetone"

# Public base URL, used in email links when the request host is unknown
APP_URL="http://localhost:3000"

# --- Payments ---
# "mock" for development; "dpayments" in production
PAYMENT_GATEWAY="mock"
DPAYMENTS_API_URL=""
DPAYMENTS_API_KEY=""
DPAYMENTS_WEBHOOK_SECRET=""

# --- Email ---
# Option 1: SMTP, e.g. Hostinger Mail (smtp.hostinger.com, port 465). The sender is SMTP_USER.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_REPLY_TO=""
# Option 2: Resend. Leave both empty to log emails to the database and console only (development).
RESEND_API_KEY=""

# Email address of the platform owner (DBS Group) account created by the seed
PLATFORM_ADMIN_EMAIL="admin@example.com"
# Email address of the Lifetone brand admin account created by the seed
BRAND_ADMIN_EMAIL="owner@example.com"
